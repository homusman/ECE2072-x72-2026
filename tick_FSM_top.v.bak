module tick_FSM_top(
    input  wire       CLOCK_50,
    input  wire [1:0] KEY,       // active low
    input  wire [9:0] SW,
    output wire [9:0] LEDR
);
    // synchronise the button into the 50 MHz domain, then detect a press
    reg [2:0] key_sync = 3'b111;
    always @(posedge CLOCK_50)
        key_sync <= {key_sync[1:0], KEY[1]};

    wire step = (key_sync[2:1] == 2'b10);   // one-cycle pulse on press (falling edge)

    wire [3:0] tick;

    tick_FSM u_fsm (
        .clk (CLOCK_50),
        .rst (~KEY[0]),
        .en  (SW[0] & step),   // SW0 up: each KEY1 press advances one state
        .tick(tick)
    );

    assign LEDR[3:0] = tick;
    assign LEDR[8:4] = 5'b0;
    assign LEDR[9]   = SW[0];
endmodule